{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "rootDir": "src",
    "outDir": "dist",
    "declaration": true,
    "tsBuildInfoFile": "./node_modules/.cache/qeetrix/tsconfig.build.tsbuildinfo"
  },
  "include": ["src"],
  "exclude": [
    "dist",
    "src/blocks",
    "src/patterns",
    "**/__tests__/**",
    "**/*.test.ts",
    "**/*.test.tsx"
  ],
  "tsc-alias": {
    "resolveFullPaths": true,
    "verbose": false
  }
}
