{
  "shadow": {
    "none": {
      "$value": "none",
      "$type": "shadow"
    },
    "inset-subtle": {
      "$value": "inset 0 1px 3px rgb(0 0 0 / 0.08)",
      "$type": "shadow"
    },
    "rest": {
      "$value": "0 1px 2px -1px rgb(0 0 0 / 0.06), 0 2px 6px -2px rgb(0 0 0 / 0.07), 0 0 0 1px rgb(0 0 0 / 0.03)",
      "$type": "shadow"
    },
    "hover": {
      "$value": "0 2px 4px -2px rgb(0 0 0 / 0.07), 0 10px 20px -5px rgb(0 0 0 / 0.12), 0 0 0 1px rgb(0 0 0 / 0.03)",
      "$type": "shadow"
    },
    "popover": {
      "$value": "0 4px 10px -3px rgb(0 0 0 / 0.08), 0 14px 32px -8px rgb(0 0 0 / 0.16), 0 0 0 1px rgb(0 0 0 / 0.04)",
      "$type": "shadow"
    },
    "modal": {
      "$value": "0 10px 20px -6px rgb(0 0 0 / 0.12), 0 36px 64px -12px rgb(0 0 0 / 0.28), 0 0 0 1px rgb(0 0 0 / 0.04)",
      "$type": "shadow"
    },
    "ramp": {
      "$description": "The Tailwind shadow ramp (shadow-2xs\u2026shadow-xl). Authored here rather than in index.css so there is one source for these values; @theme references the generated vars.",
      "2xs": {
        "$value": "0 1px 1px rgb(0 0 0 / 0.05)",
        "$type": "shadow"
      },
      "xs": {
        "$value": "0 1px 2px -1px rgb(0 0 0 / 0.06)",
        "$type": "shadow"
      },
      "sm": {
        "$value": "0 1px 2px -1px rgb(0 0 0 / 0.06), 0 2px 4px -2px rgb(0 0 0 / 0.06)",
        "$type": "shadow"
      },
      "md": {
        "$value": "0 2px 4px -2px rgb(0 0 0 / 0.06), 0 6px 12px -3px rgb(0 0 0 / 0.1)",
        "$type": "shadow"
      },
      "lg": {
        "$value": "0 4px 8px -3px rgb(0 0 0 / 0.08), 0 14px 28px -6px rgb(0 0 0 / 0.12)",
        "$type": "shadow"
      },
      "xl": {
        "$value": "0 8px 16px -4px rgb(0 0 0 / 0.1), 0 28px 56px -10px rgb(0 0 0 / 0.16)",
        "$type": "shadow"
      }
    }
  }
}
