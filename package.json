{
  "name": "@qeetrix/ui",
  "version": "2.1.1",
  "private": false,
  "description": "Qeetrix UI — the Qeet Group React component library (shadcn + Base UI, Tailwind v4).",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qeetgroup/qeetrix-ui.git"
  },
  "bugs": {
    "url": "https://github.com/qeetgroup/qeetrix-ui/issues"
  },
  "homepage": "https://github.com/qeetgroup/qeetrix-ui#readme",
  "type": "module",
  "packageManager": "bun@1.3.14",
  "engines": {
    "node": ">=20",
    "bun": ">=1.3.14"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./styles.css": "./dist/styles/index.css",
    "./qeetrix.css": "./dist/styles/tokens.css",
    "./tokens.css": "./dist/styles/tokens.raw.css",
    "./tokens.json": "./dist/styles/tokens.json",
    "./manifest.json": "./dist/component-manifest.json",
    "./brand": {
      "types": "./dist/brand/index.d.ts",
      "import": "./dist/brand/index.js",
      "default": "./dist/brand/index.js"
    },
    "./providers": {
      "types": "./dist/providers/index.d.ts",
      "import": "./dist/providers/index.js",
      "default": "./dist/providers/index.js"
    },
    "./providers/density-provider": {
      "types": "./dist/providers/density-provider.d.ts",
      "import": "./dist/providers/density-provider.js",
      "default": "./dist/providers/density-provider.js"
    },
    "./providers/direction-provider": {
      "types": "./dist/providers/direction-provider.d.ts",
      "import": "./dist/providers/direction-provider.js",
      "default": "./dist/providers/direction-provider.js"
    },
    "./providers/messages-provider": {
      "types": "./dist/providers/messages-provider.d.ts",
      "import": "./dist/providers/messages-provider.js",
      "default": "./dist/providers/messages-provider.js"
    },
    "./providers/theme-provider": {
      "types": "./dist/providers/theme-provider.d.ts",
      "import": "./dist/providers/theme-provider.js",
      "default": "./dist/providers/theme-provider.js"
    },
    "./components/*": {
      "types": "./dist/components/*.d.ts",
      "import": "./dist/components/*.js",
      "default": "./dist/components/*.js"
    },
    "./components/ui/*": {
      "types": "./dist/components/ui/*.d.ts",
      "import": "./dist/components/ui/*.js",
      "default": "./dist/components/ui/*.js"
    },
    "./hooks/use-media-query": {
      "types": "./dist/hooks/use-media-query.d.ts",
      "import": "./dist/hooks/use-media-query.js",
      "default": "./dist/hooks/use-media-query.js"
    },
    "./hooks/use-mobile": {
      "types": "./dist/hooks/use-mobile.d.ts",
      "import": "./dist/hooks/use-mobile.js",
      "default": "./dist/hooks/use-mobile.js"
    },
    "./hooks/use-motion": {
      "types": "./dist/hooks/use-motion.d.ts",
      "import": "./dist/hooks/use-motion.js",
      "default": "./dist/hooks/use-motion.js"
    },
    "./hooks/use-prefers-reduced-motion": {
      "types": "./dist/hooks/use-prefers-reduced-motion.d.ts",
      "import": "./dist/hooks/use-prefers-reduced-motion.js",
      "default": "./dist/hooks/use-prefers-reduced-motion.js"
    },
    "./lib/motion": {
      "types": "./dist/lib/motion.d.ts",
      "import": "./dist/lib/motion.js",
      "default": "./dist/lib/motion.js"
    },
    "./lib/responsive": {
      "types": "./dist/lib/responsive.d.ts",
      "import": "./dist/lib/responsive.js",
      "default": "./dist/lib/responsive.js"
    },
    "./lib/token-values": {
      "types": "./dist/lib/token-values.d.ts",
      "import": "./dist/lib/token-values.js",
      "default": "./dist/lib/token-values.js"
    },
    "./lib/utils": {
      "types": "./dist/lib/utils.d.ts",
      "import": "./dist/lib/utils.js",
      "default": "./dist/lib/utils.js"
    },
    "./fonts/*": "./dist/fonts/*",
    "./package.json": "./package.json"
  },
  "scripts": {
    "dev": "node scripts/build/tokens.mjs && tsc -p tsconfig.build.json --watch --noEmit",
    "build": "bun run clean && node scripts/build/tokens.mjs && node scripts/build/manifest.mjs && tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json && node scripts/build/subpath-shims.mjs && node scripts/build/postbuild.mjs",
    "typecheck": "tsc -p tsconfig.build.json --noEmit && tsc -p playground/tsconfig.json --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:manifest": "node scripts/build/manifest.mjs",
    "build:tokens": "node scripts/build/tokens.mjs",
    "clean": "node scripts/build/clean.mjs",
    "prepack": "bun run build",
    "playground": "vite --config playground/vite.config.ts",
    "playground:build": "vite build --config playground/vite.config.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.5.0",
    "@qeetrix/icons": "^1.0.11",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/react-virtual": "^3.14.3",
    "@tiptap/pm": "^3.27.0",
    "@tiptap/react": "^3.27.0",
    "@tiptap/starter-kit": "^3.27.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "embla-carousel-react": "^8.6.0",
    "qrcode": "^1.5.4",
    "react-day-picker": "^9.9.0",
    "react-resizable-panels": "^4.11.2",
    "recharts": "^3.8.1",
    "shadcn": "^4.7.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.3.6"
  },
  "peerDependencies": {
    "react": ">=19",
    "react-dom": ">=19",
    "tailwindcss": ">=4"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.0.0",
    "@tailwindcss/vite": "^4.3.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.19.19",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitest/browser-playwright": "^4.1.9",
    "@vitest/coverage-v8": "^4.1.9",
    "axe-core": "^4.12.1",
    "culori": "^4.0.1",
    "jsdom": "^29.1.1",
    "playwright": "^1.57.0",
    "style-dictionary": "^5.4.1",
    "tailwindcss": "^4.3.0",
    "tsc-alias": "^1.8.17",
    "typescript": "^6.0.3",
    "vite": "^8.2.2",
    "vitest": "^4.1.9",
    "vitest-axe": "^0.1.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
